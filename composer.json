{
    "name": "strukt/base",
    "description": "Base Classes",
    "type": "package",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Strukt\\": "src/Strukt"
        },
        "files":["src/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Fixture\\":"fixture/Fixture/"
        }
    },
    "authors": [
        {
            "name": "pitsolu",
            "email": "pitsolu@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "require-dev": {
        "pestphp/pest": "4.x-dev",
        "symfony/var-dumper": "6.4.x-dev"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
